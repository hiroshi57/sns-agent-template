{
  "name": "sns-agent-template",
  "version": "1.0.0",
  "description": "Chatwork/RSS ニュース → X/Instagram/TikTok/note マルチSNS自動投稿 + PDCA 自走エージェント",
  "main": "dist/index-x.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "x:setup": "ts-node src/setup-x-session.ts",
    "x:keepalive": "ts-node src/x/session-keepalive.ts",
    "x:analytics": "ts-node src/x/analytics-scraper.ts",
    "dashboard": "ts-node src/dashboard/server.ts",
    "dashboard:delivery": "ts-node src/dashboard/delivery-dashboard.ts",
    "x:dev": "ts-node src/index-x.ts",
    "x:once": "ts-node src/index-x.ts --once --force",
    "x:dry-run": "ts-node src/index-x.ts --once --force --dry-run",
    "x:start": "node dist/index-x.js",
    "x:report": "ts-node src/index-x.ts --report",
    "x:retry": "ts-node src/x/retry-until-posted.ts",
    "x:all": "ts-node src/x/post-all-slots.ts",
    "x:slot11": "ts-node src/index-x.ts --once --force --slot slot11",
    "x:slot12": "ts-node src/index-x.ts --once --force --slot slot12",
    "x:slot14": "ts-node src/index-x.ts --once --force --slot slot14",
    "x:slot17": "ts-node src/index-x.ts --once --force --slot slot17",
    "apps:post": "ts-node src/x/post-micro-apps.ts",
    "apps:post:dry-run": "ts-node src/x/post-micro-apps.ts --dry-run",
    "instagram:setup": "ts-node src/instagram/setup-session.ts",
    "instagram:once": "ts-node src/index-instagram.ts --once --force",
    "instagram:dry-run": "ts-node src/index-instagram.ts --once --force --dry-run",
    "instagram:dev": "ts-node src/index-instagram.ts",
    "instagram:start": "node dist/index-instagram.js",
    "note:setup": "ts-node src/note/setup-session.ts",
    "note:edit-seo": "ts-node src/note/edit-seo-articles.ts",
    "note:publish-drafts": "ts-node src/note/publish-drafts.ts",
    "note:publish-seo": "ts-node src/note/publish-seo-articles.ts",
    "note:publish-seo:dry": "ts-node src/note/publish-seo-articles.ts --dry-run",
    "note:daily": "ts-node src/index-note.ts --once",
    "note:weekly": "ts-node src/index-note.ts --once",
    "note:dry-run": "ts-node src/index-note.ts --once --dry-run",
    "note:dev": "ts-node src/index-note.ts",
    "note:start": "node dist/index-note.js",
    "tiktok:setup": "ts-node src/tiktok/setup-session.ts",
    "tiktok:once": "ts-node src/index-tiktok.ts --once --force",
    "tiktok:dry-run": "ts-node src/index-tiktok.ts --once --force --dry-run",
    "tiktok:dev": "ts-node src/index-tiktok.ts",
    "tiktok:start": "node dist/index-tiktok.js",
    "pdca:analyze": "ts-node src/pdca.ts analyze",
    "pdca:status": "ts-node src/pdca.ts status",
    "pdca:reset": "ts-node src/pdca.ts reset",
    "kpi:display": "ts-node src/utils/kpi-display.ts",
    "pdca:slot-analysis": "ts-node src/pdca-slot-analysis.ts",
    "affiliate:post": "ts-node src/x/run-affiliate-ranking.ts",
    "affiliate:dry-run": "ts-node src/x/run-affiliate-ranking.ts --dry-run",
    "seo:post-x": "ts-node src/x/post-seo-x.ts",
    "seo:post-x:dry": "ts-node src/x/post-seo-x.ts --dry-run",
    "pdca:weekly": "ts-node src/pdca-weekly.ts",
    "pdca:daily-check": "ts-node src/pdca-daily-check.ts",
    "dashboard:generate": "node scripts/generate-dashboard.js",
    "pm2:setup": "node scripts/pm2-setup.js",
    "pm2:start": "npm run build && pm2 start ecosystem.config.js && pm2 save",
    "pm2:restart": "npm run build && pm2 restart ecosystem.config.js && pm2 save",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js && pm2 save",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs --lines 100",
    "pm2:monit": "pm2 monit",
    "pm2:flush": "pm2 flush",
    "pm2:autostart": "powershell -ExecutionPolicy Bypass -File scripts\\pm2-windows-autostart.ps1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "node-cron": "^3.0.3",
    "playwright": "^1.49.1",
    "twitter-api-v2": "^1.29.0",
    "winston": "^3.17.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
