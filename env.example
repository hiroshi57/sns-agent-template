# ============================================================
# sns-agent-template 環境変数
#
# 使い方:
#   1. このファイルを .env にコピー: cp env.example .env
#   2. 各値を自分のアカウント情報に書き換える
#   3. GitHub Actions で運用する場合は同名の Secrets を登録する
#
# ⚠️ .env は絶対にコミットしないこと（.gitignore 済み）
# ============================================================

# ========================================
# Chatwork（入力ソース）
# ========================================
# 取得手順: Chatwork → 右上メニュー → サービス連携 → API Token
CHATWORK_API_TOKEN=your_chatwork_api_token
# 対象ルームの URL 末尾の数字（例: chatwork.com/#!rid123456789 → 123456789）
CHATWORK_ROOM_ID=your_chatwork_room_id
# 転送対象にする投稿者の Chatwork アカウントID（カンマ区切りで複数可）
# 空の場合は全員のメッセージを対象にする
CHATWORK_TARGET_ACCOUNT_IDS=your_account_id

# ========================================
# Claude API（要約・戦略分析に使用）
# ========================================
# 取得手順: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ========================================
# X (Twitter) ログイン情報（Playwright 自動操作用）
# ========================================
X_EMAIL=your-x-email@example.com
X_PASSWORD=your-x-password
# ユーザー名（@なし）— ログイン時に追加確認が出た場合に使用
X_USERNAME=your_x_username
# 電話番号（国番号付き: +8190XXXXXXXX）— 本人確認チャレンジ自動突破用
X_PHONE=+8190XXXXXXXX

# ========================================
# Instagram / Threads ログイン情報（Playwright 自動操作用）
# ========================================
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
# Threads にも同時投稿するか（false で Instagram のみ）
INSTAGRAM_POST_THREADS=true

# ========================================
# TikTok ログイン情報（Playwright 自動操作用）
# ========================================
TIKTOK_USERNAME=your_tiktok_email_or_username
TIKTOK_PASSWORD=your_tiktok_password

# ========================================
# note ログイン情報（Playwright 自動操作用）
# ========================================
NOTE_EMAIL=your-note-email@example.com
NOTE_PASSWORD=your-note-password

# ========================================
# 自社サービス誘導（note 記事フッターに埋め込み）
# ========================================
OWN_SERVICE_NAME=サービス名
OWN_SERVICE_URL=https://your-service.example.com
# アフィリエイトテキスト（空でもOK）
NOTE_AFFILIATE_TEXT=
# X 投稿から note へ誘導する CTA リンク先（空で無効）
NOTE_CTA_URL=

# ========================================
# X アフィリエイトランキング投稿
# ========================================
# data/affiliate-products.json に製品データを記載すると
# slot11（11:00）完了後に自動でランキング TOP3 を投稿する
# （雛形: data/affiliate-products.example.json をコピーして編集）
#
# アフィリエイトランキング投稿を無効にする場合は false を設定
AFFILIATE_RANKING_ENABLED=true
# ランキング投稿を実行するスロット（デフォルト: slot11）
AFFILIATE_RANKING_SLOT=slot11

# ========================================
# GitHub Actions 自動化
# ========================================
# セッション Secret の自動書き戻しに使用（repo + secrets scope が必要）
# GitHub Settings > Developer settings > Personal access tokens で生成
GH_PAT=
# ダッシュボードが GitHub API を叩く際に使用（未設定なら匿名アクセス）
GITHUB_TOKEN=

# ========================================
# アラート通知（いずれか1つ以上を設定すると通知が届く）
# ========================================
# LINE Notify トークン（https://notify-bot.line.me/ で取得）
LINE_NOTIFY_TOKEN=
# Slack Incoming Webhook URL（Slack App の Incoming Webhooks で生成）
SLACK_WEBHOOK_URL=
# Discord Webhook URL（サーバー設定 > 連携サービス で生成）
DISCORD_WEBHOOK_URL=

# ========================================
# ダッシュボード
# ========================================
# ローカルダッシュボード（npm run dashboard）の待受ポート
DASHBOARD_PORT=3000
# Vercel KV を使う場合のみ設定（未設定なら GitHub Raw から取得）
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ========================================
# コンテンツフィルター・品質設定
# ========================================
# Chatwork メッセージの意見フィルター閾値（1〜5、デフォルト: 4）
# 低くすると厳しくなる（より多くのメッセージをフィルタ）
OPINION_THRESHOLD=4
# 品質スコアリングで選択する上位件数（デフォルト: 20）
QUALITY_TOP_N=20
# 引用収集の最小いいね数 / 最大引用数（コレクター用・省略可）
MIN_LIKES=
MAX_QUOTES=

# ========================================
# MicroApps プロモ投稿（省略可）
# ========================================
# 投稿に添付するデフォルト画像 URL（未設定ならテキストのみ）
MICRO_APPS_DEFAULT_IMAGE_URL=

# ========================================
# 実行モード
# ========================================
# dry-run モード: true にすると投稿をスキップ
DRY_RUN=false
# 強制実行フラグ（デバッグ・手動検証用、通常は未設定でOK）
FORCE_ADAPTIVE_SCALER=
FORCE_NOTE_CTA=
FORCE_SEO_MONTHLY=
